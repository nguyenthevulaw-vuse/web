# Sao chép file này thành `.env.local` (dev) và cấu hình các biến tương ứng
# trên Vercel (Production/Preview) trước khi deploy.
#
# Lấy 2 giá trị bên dưới tại: Supabase Dashboard → Project Settings → API
# Nếu để trống, website vẫn chạy được bình thường bằng dữ liệu mẫu có sẵn
# trong `src/lib/data.ts` — tiện cho việc phát triển/preview khi chưa có
# dự án Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gửi email thông báo khi có khách hàng gửi form Liên hệ. Ưu tiên dùng
# Microsoft Graph (hộp thư Microsoft 365 công ty, 4 biến MS_GRAPH_* bên
# dưới) nếu đã cấu hình đủ. Nếu chưa, dùng Resend (RESEND_API_KEY) làm
# phương án dự phòng. Nếu để trống cả hai, yêu cầu liên hệ vẫn được lưu
# vào Supabase như bình thường, chỉ là không có email nhắc.

# Gửi qua Microsoft 365 (Microsoft Graph API) — cần tạo "App registration"
# trong Azure/Entra admin (portal.azure.com hoặc admin.microsoft.com) với
# quyền ứng dụng (Application permission) "Mail.Send", đã được Admin consent.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Hộp thư Microsoft 365 dùng để gửi đi, vd. "vunt@ntvlaw.vn"
MS_GRAPH_SENDER_EMAIL=

# Gửi qua Resend (resend.com, có gói miễn phí) — dùng khi không cấu hình
# Microsoft Graph. Lấy API key tại: Resend Dashboard → API Keys.
RESEND_API_KEY=

# Tuỳ chọn — mặc định gửi từ "NTVLaw Website <onboarding@resend.dev>" (địa
# chỉ dùng thử của Resend, gửi được ngay không cần xác minh tên miền). Sau
# khi xác minh tên miền ntvlaw.vn trên Resend, đổi sang địa chỉ thuộc tên
# miền riêng để tăng độ tin cậy, ví dụ: "NTVLaw <noreply@ntvlaw.vn>"
RESEND_FROM_EMAIL=

# Tuỳ chọn — email nhận thông báo. Mặc định lấy theo contact.email trong
# src/lib/site-config.ts nếu để trống.
CONTACT_NOTIFICATION_EMAIL=
