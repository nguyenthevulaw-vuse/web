# Sao chép file này thành `.env.local` (dev) và cấu hình các biến tương ứng
# trên Vercel (Production/Preview) trước khi deploy.
#
# Lấy 2 giá trị bên dưới tại: Supabase Dashboard → Project Settings → API
# Nếu để trống, website vẫn chạy được bình thường bằng dữ liệu mẫu có sẵn
# trong `src/lib/data.ts` — tiện cho việc phát triển/preview khi chưa có
# dự án Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gửi email thông báo khi có khách hàng gửi form Liên hệ (dùng Resend —
# resend.com, có gói miễn phí). Nếu để trống, yêu cầu liên hệ vẫn được lưu
# vào Supabase như bình thường, chỉ là không có email nhắc.
# Lấy API key tại: Resend Dashboard → API Keys.
RESEND_API_KEY=

# Tuỳ chọn — mặc định gửi từ "NTVLaw Website <onboarding@resend.dev>" (địa
# chỉ dùng thử của Resend, gửi được ngay không cần xác minh tên miền). Sau
# khi xác minh tên miền ntvlaw.vn trên Resend, đổi sang địa chỉ thuộc tên
# miền riêng để tăng độ tin cậy, ví dụ: "NTVLaw <noreply@ntvlaw.vn>"
RESEND_FROM_EMAIL=

# Tuỳ chọn — email nhận thông báo. Mặc định lấy theo contact.email trong
# src/lib/site-config.ts nếu để trống.
CONTACT_NOTIFICATION_EMAIL=
