# Sao chép file này thành `.env.local` (dev) và cấu hình các biến tương ứng
# trên Vercel (Production/Preview) trước khi deploy.
#
# Lấy 2 giá trị bên dưới tại: Supabase Dashboard → Project Settings → API
# Nếu để trống, website vẫn chạy được bình thường bằng dữ liệu mẫu có sẵn
# trong `src/lib/data.ts` — tiện cho việc phát triển/preview khi chưa có
# dự án Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
